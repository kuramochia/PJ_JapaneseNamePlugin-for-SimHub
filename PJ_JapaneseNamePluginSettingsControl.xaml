<UserControl
    x:Class="Kuramochia.PJ_JapaneseNamePlugin.PJ_JapaneseNamePluginSettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converter="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:iconpacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Material"
    xmlns:local="clr-namespace:Kuramochia.PJ_JapaneseNamePlugin"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:styles="clr-namespace:SimHub.Plugins.Styles;assembly=SimHub.Plugins"
    xmlns:ui="clr-namespace:SimHub.Plugins.UI;assembly=SimHub.Plugins"
    mc:Ignorable="d">
    <ScrollViewer>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <styles:SHSection
                Title="PJ Japanese Name Plugin Setting"
                Grid.ColumnSpan="2"
                ShowSeparator="True">
                <StackPanel>
                    <styles:SHButtonPrimary
                        x:Name="updateButton"
                        Content="強制更新"
                        Click="updateButton_Click"/>
                    <styles:SHSubSection Title="JSON URL">
                        <TextBox x:Name="jsonUrlTextBox" TextChanged="jsonUrlTextBox_TextChanged"/>
                    </styles:SHSubSection>
                    <styles:SHSubSection Title="最終更新日時">
                        <TextBlock x:Name="lastUpdatedTextBlock"/>
                    </styles:SHSubSection>

                    <styles:SHSubSection
                        Title="使い方">
                        <TextBlock>
                            <Run>このプラグインは、4つのデータを追加して提供します。</Run>
                            <LineBreak/>
                            <Run>各データは、ProjectJapan マップの場合(都市名が一致する場合)は日本語に変換して出力、それ以外のマップの場合は、標準の名前になります。</Run>
                            <LineBreak/>
                            <LineBreak/>
                            <Run>　"PJ_JapaneseNamePlugin.Job.CitySource" : 日本語の配送元都市名</Run>
                            <LineBreak/>
                            <Run>　"PJ_JapaneseNamePlugin.Job.CityDestination" : 日本語の配送先都市名</Run>
                            <LineBreak/>
                            <Run>　"PJ_JapaneseNamePlugin.Job.CompanySource" : 日本語の配送元企業名</Run>
                            <LineBreak/>
                            <Run>　"PJ_JapaneseNamePlugin.Job.CompanyDestination" : 日本語の配送先企業名</Run>
                            <LineBreak/>
                            <LineBreak/>
                            <Run>起動時に JSON データをダウンロードして、日本語への変換情報を取得します。</Run>
                            <LineBreak/>
                            <Run>「強制更新」ボタンをクリックすると、手動で JSON データを再ダウンロードできます。</Run>
                        </TextBlock>
                    </styles:SHSubSection>
                </StackPanel>
            </styles:SHSection>
        </Grid>
    </ScrollViewer>
</UserControl>